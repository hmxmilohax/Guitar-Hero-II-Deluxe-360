{new
   HelpBarPanel
   helpbar
   (file helpbar.milo)
   (max_labels 4)
   (max_buttons 4)
   (button_spacing 35)
   (strumbar_spacing 70)
   (text_spacing 30)}
{new
   MetaPanel
   meta
   (file
      "")
   (won_campaign FALSE)
   (load
      {set_loader_period 13})
   (enter
      {set_loader_period 5}
      {profilemgr enable_xmp})
   (exit
      {profilemgr disable_xmp})
   (set_defaults
      {set $first_screen main_screen}
      {set $autosave FALSE}
      {set $main_entered FALSE}
      {gamecfg set mode quickplay})}
{new
   UIPanel
   splash_panel
   (player_num 0)
   (enter
      {campaign clear}
      {reset_all_cheats}
      {set
         $enter_time
         {taskmgr ui_seconds}}
      {profilemgr clear_active_pad}
      {if
         $signin_changed_notification
         {set $signin_changed_notification FALSE}
         {ui push_screen signin_changed_confirmation_screen}}
      {profilemgr set_active_pad_from_player $player_num}
      {gamecfg set_player 0 {profilemgr active_padnum}}
      {ui set_virtual_dpad TRUE}
      {goto_startup_load})}
{new
   GHScreen
   splash_screen
   (panels meta splash_panel)
   (focus splash_panel)
   (allow_back FALSE)
   (animate_transition FALSE)
   (allow_all_controllers TRUE)}
{new
   GHPanel
   signin_changed_confirmation_panel
   (file signin_changed.milo)
   (focus continue.btn)}
{new
   GHScreen
   signin_changed_confirmation_screen
   (panels signin_changed_confirmation_panel)
   (focus signin_changed_confirmation_panel)
   (allow_back FALSE)
   (animate_transition FALSE)
   (SELECT_START_MSG
      {switch
         $component
         (continue.btn
            {ui pop_screen})})}
#include username.dta
#include saveload.dta
#include loading.dta
#include game.dta
#include songselect.dta
#include endgame.dta
#include partselect.dta
#include multiplayer.dta
#include mainmenu.dta
#include calibration.dta
#include audioset.dta
#include memcard.dta
#include overshell.dta
#include overshell_handlers.dta
#include practice.dta
#include pause.dta
#include seldiff.dta
#include managegig.dta
#include options.dta
#include dxdebug.dta
{foreach $p (pause_panel pause_controller_panel tut_pause_panel pract_pause_panel tut_pause_controller_panel lose_panel helpbar endgame_encore_panel) {$p load}}
{meta set_defaults}
#ifdef HX_XBOX {set $first_screen splash_screen} #endif
{ui my_init}
{do
   ($cfg)
   {if
      {option_str budget_config $cfg}
      {track_budget setup $cfg}
      {set $first_screen track_budget}}}

#ifdef HX_XBOX
{set $dxsettings {load_objects "GAME:/dxsettings.milo"}}
{set $dxuitheme {load_objects "GAME:/dxuitheme.milo"}}
{set $dxtracktheme {load_objects "GAME:/dxtracktheme.milo"}}
{if_else $dxsettings
   {do
      LOAD_DX_SETTINGS
      {if_else $dxuitheme
         {do
            LOAD_DX_UI_THEME
         }
         {do
            SAVE_DX_UI_THEME
         }
      }
      {if_else $dxtracktheme
         {do
            LOAD_DX_TRACK_THEME
         }
         {do
            SAVE_DX_TRACK_THEME
         }
      }
   }
   {do
      #include game:/init_track_theme.dta
      #include game:/init_ui_theme.dta
      #include game:/init.dta
      {if {&& $customgemcolor {! $newcustomgemcolor}}
         {set $newcustomgemcolor TRUE}
         {set $gem1color_r $gemcolor_r}
         {set $gem1color_g $gemcolor_g}
         {set $gem1color_b $gemcolor_b}
         {set $gem2color_r $gemcolor_r}
         {set $gem2color_g $gemcolor_g}
         {set $gem2color_b $gemcolor_b}
         {set $gem3color_r $gemcolor_r}
         {set $gem3color_g $gemcolor_g}
         {set $gem3color_b $gemcolor_b}
         {set $gem4color_r $gemcolor_r}
         {set $gem4color_g $gemcolor_g}
         {set $gem4color_b $gemcolor_b}
         {set $gem5color_r $gemcolor_r}
         {set $gem5color_g $gemcolor_g}
         {set $gem5color_b $gemcolor_b}
      }
      {if {&& $customsmashercolor {! $newcustomsmashercolor}}
         {set $newcustomsmashercolor TRUE}
         {set $smasher1color_r $smashercolor_r}
         {set $smasher1color_g $smashercolor_g}
         {set $smasher1color_b $smashercolor_b}
         {set $smasher2color_r $smashercolor_r}
         {set $smasher2color_g $smashercolor_g}
         {set $smasher2color_b $smashercolor_b}
         {set $smasher3color_r $smashercolor_r}
         {set $smasher3color_g $smashercolor_g}
         {set $smasher3color_b $smashercolor_b}
         {set $smasher4color_r $smashercolor_r}
         {set $smasher4color_g $smashercolor_g}
         {set $smasher4color_b $smashercolor_b}
         {set $smasher5color_r $smashercolor_r}
         {set $smasher5color_g $smashercolor_g}
         {set $smasher5color_b $smashercolor_b}
      }
      SAVE_DX_SETTINGS
      SAVE_DX_UI_THEME
      SAVE_DX_TRACK_THEME
   }
}
{delete $dxsettings}
{delete $dxuitheme}
{delete $dxtracktheme}
#include init_extras.dta
#else
#include ui/init_track_theme.dta
#include ui/init_ui_theme.dta
#endif
#include init_dev.dta

;DEV OPTIONS BELOW, DO NOT MODIFY

;skip part/difficulty select
{set $diffseen FALSE}

;skip help screen
{set $helpentered TRUE}
